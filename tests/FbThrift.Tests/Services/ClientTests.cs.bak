public class TcpTransportTests
{
    [Fact]
    public void SocketTransport_CanBeCreated()
    {
        var socket = new Socket(AddressFamily.InterNetwork, SocketType.Stream, System.Net.Sockets.ProtocolType.Tcp);
        var transport = new SocketFbThriftTransport(socket);
        
        Assert.NotNull(transport);
    }

    [Fact]
    public void FramedTransport_CanWrapTransport()
    {
        var socket = new Socket(AddressFamily.InterNetwork, SocketType.Stream, System.Net.Sockets.ProtocolType.Tcp);
        var innerTransport = new SocketFbThriftTransport(socket);
        var framedTransport = new FramedTransport(innerTransport);
        
        Assert.NotNull(framedTransport);
    }

    [Fact]
    public void UnframedTransport_CanWrapTransport()
    {
        var socket = new Socket(AddressFamily.InterNetwork, SocketType.Stream, System.Net.Sockets.ProtocolType.Tcp);
        var innerTransport = new SocketFbThriftTransport(socket);
        var unframedTransport = new UnframedTransport(innerTransport);
        
        Assert.NotNull(unframedTransport);
    }
}