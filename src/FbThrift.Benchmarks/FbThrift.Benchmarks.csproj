<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;NU1510;NU1603</NoWarn>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <IsPublishable>false</IsPublishable>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\FbThrift.Core\FbThrift.Core.csproj" />
    <ProjectReference Include="..\FbThrift.LoadBalancing\FbThrift.LoadBalancing.csproj" />
    <ProjectReference Include="..\FbThrift.Client\FbThrift.Client.csproj" />
    <ProjectReference Include="..\FbThrift.Serialization.Binary\FbThrift.Serialization.Binary.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.14.0" />
  </ItemGroup>

</Project>
