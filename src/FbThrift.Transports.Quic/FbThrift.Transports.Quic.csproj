<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;NU1510;NU1603</NoWarn>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageId>FbThrift.Transports.Quic</PackageId>
    <Title>FbThrift QUIC Transport</Title>
    <Description>QUIC transport for FbThrift with HTTP/3 support</Description>
    <Authors>FbThrift Contributors</Authors>
    <PackageTags>fbthrift;thrift;transport;quic;http3</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/meta/fbthrift</PackageProjectUrl>
    <RepositoryUrl>https://github.com/meta/fbthrift</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\FbThrift.Core\FbThrift.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="9.0.0" />
    <PackageReference Include="System.Net.Quic" Version="9.0.0" />
    <PackageReference Include="System.Threading.Channels" Version="10.0.14" />
  </ItemGroup>

</Project>