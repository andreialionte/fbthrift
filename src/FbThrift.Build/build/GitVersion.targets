<Project>
  <!-- GitVersion.targets - Automated versioning from Git tags -->
  <!-- This file can be used to automatically generate version numbers from Git tags -->

  <PropertyGroup>
    <GitVersionCommand>git describe --tags --always --dirty=-dirty</GitVersionCommand>
    <GitVersionWorkingDirectory>$(MSBuildThisFileDirectory)..\..\..</GitVersionWorkingDirectory>
  </PropertyGroup>

  <Target Name="GetGitVersion" BeforeTargets="BeforeBuild" Condition="'$(VersionPrefix)' == ''">
    <Exec Command="$(GitVersionCommand)"
          WorkingDirectory="$(GitVersionWorkingDirectory)">
      <Output TaskParameter="ExitCode" PropertyName="GitDescribeExitCode" />
      <Output TaskParameter="ConsoleOutput" PropertyName="GitDescribeOutput" />
    </Exec>
    <PropertyGroup>
      <VersionPrefix Condition="'$(GitDescribeExitCode)' == '0'">$(GitDescribeOutput.TrimStart('v'))</VersionPrefix>
      <VersionPrefix Condition="'$(VersionPrefix)' == ''">1.0.0</VersionPrefix>
    </PropertyGroup>
  </Target>

  <Target Name="GenerateVersionInfo" BeforeTargets="CoreCompile">
    <PropertyGroup>
      <AssemblyVersion>$(VersionPrefix)</AssemblyVersion>
      <FileVersion>$(VersionPrefix)</FileVersion>
      <InformationalVersion>$(Version)</InformationalVersion>
    </PropertyGroup>
  </Target>

</Project>